{
  "name": "@this-project/tests",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:cli && pnpm run test:host-commands && pnpm run test:scenarios",
    "test:unit": "vitest run host control-plane contracts installer web git-review-tracing git-tools cli/host --exclude 'scenarios/**' --maxWorkers=2",
    "test:cli": "tsx --conditions=dim-source --test --test-reporter=./support/node-failure-reporter.ts cli/*.test.ts",
    "test:web-journeys": "node --disable-warning=DEP0205 --import tsx --conditions=dim-source web/journeys/run.ts",
    "test:web-native-management": "node --disable-warning=DEP0205 --import tsx --conditions=dim-source web/plugins/nativeManagement.e2e.ts",
    "test:web-git-sync": "node --disable-warning=DEP0205 --import tsx --conditions=dim-source web/plugins/nativeBranchMerge.e2e.ts",
    "test:git-tools-web": "node --disable-warning=DEP0205 --import tsx --conditions=source git-tools/reactPullRequests.e2e.ts",
    "test:scenarios": "vitest run scenarios/harness scenarios/llm-router scenarios/execution --no-file-parallelism --exclude 'scenarios/harness/qemu*.test.ts' --exclude 'scenarios/harness/kvm*.test.ts' --exclude 'scenarios/harness/bootstrapInstallerSafety.test.ts'",
    "test:qemu-service": "node -e 'if (process.getuid?.() !== 0) { console.error(\"QEMU service fixtures require a disposable root environment; see docs/development/verification.md\"); process.exit(2); }' && vitest run --config vitest.privileged.config.ts",
    "test:host-commands": "tsx --conditions=dim-source --test --test-reporter=./support/node-failure-reporter.ts host/core/application/commands/*.node.test.ts"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright-core": "1.64.1",
    "jsonc-parser": "3.3.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "ws": "8.22.0",
    "@types/ws": "8.18.2",
    "verdaccio": "6.8.0",
    "yaml": "2.8.3",
    "@slop-lab/dim-contracts-ci": "workspace:*",
