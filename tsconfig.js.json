{
  "extends": "./tsconfig.source.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./tests/node_modules/@types"
    ]
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    ".git/**",
    ".local/**"
  ]
}
