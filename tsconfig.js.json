{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@slop-lab/dim-core": [
        "core/packages/core/src/index.ts"
      ],
      "@slop-lab/dim-contracts-external-url": [
        "core/packages/contracts/external-url/src/index.ts"
      ],
      "@slop-lab/dim-core/workspace": [
        "core/packages/core/src/workspace.ts"
      ],
      "@slop-lab/dim-managed": [
        "core/packages/managed/src/index.ts"
      ],
      "@slop-lab/dim-managed/cli": [
        "core/packages/managed/src/cli/managed-cli.ts"
      ],
      "@slop-lab/dim-plugin-ci-workflows": [
        "plugin-ci-workflows/src/index.ts"
      ],
      "@slop-lab/dim-native-git/config": [
        "core/packages/native-git/src/bundle-config.ts"
      ],
      "@slop-lab/dim-native-git/service": [
        "core/packages/native-git/src/service.ts"
      ],
      "@slop-lab/dim-native-git/workflow": [
        "core/packages/native-git/src/workflowCompiler.ts"
      ],
      "@slop-lab/dim-native-git/execution": [
        "core/packages/native-git/src/execution-protocol.ts"
      ]
    }
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    ".git/**",
    ".local/**"
  ]
}
