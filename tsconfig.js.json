{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@slop-lab/dim-core": [
        "core/packages/core/src/index.ts"
      ],
      "@slop-lab/dim-contracts-external-url": [
        "core/packages/contracts/external-url/src/index.ts"
      ],
      "@slop-lab/dim-core/workspace": [
        "core/packages/core/src/workspace.ts"
      ],
      "@slop-lab/dim-managed": [
        "core/packages/managed/src/index.ts"
      ],
      "@slop-lab/dim-managed/cli": [
        "core/packages/managed/src/cli/managed-cli.ts"
      ],
      "@slop-lab/dim-plugin-control-plane-ci-workflows": [
        "plugin-control-plane-ci-workflows/src/index.ts"
      ],
      "@slop-lab/dim-plugin-control-plane-native-git/config": [
        "plugin-control-plane-native-git/src/bundle-config.ts"
      ],
      "@slop-lab/dim-plugin-control-plane-native-git/service": [
        "plugin-control-plane-native-git/src/service.ts"
      ],
      "@slop-lab/dim-plugin-control-plane-native-git/workflow": [
        "plugin-control-plane-native-git/src/workflowCompiler.ts"
      ],
      "@slop-lab/dim-plugin-control-plane-native-git/execution": [
        "plugin-control-plane-native-git/src/execution-protocol.ts"
      ],
      "@slop-lab/dim-plugin-vm": [
        "plugin-vm/src/index.ts"
      ],
      "@slop-lab/dim-plugin-host-llm-router": [
        "plugin-host-llm-router/src/index.ts"
      ],
      "@slop-lab/dim-plugin-workspace-check": [
        "plugin-workspace-check/src/index.ts"
      ],
      "@slop-lab/dim-plugin-agent-tools": [
        "plugin-agent-tools/src/index.ts"
      ],
      "@slop-lab/dim-plugin-tunnels": [
        "plugin-tunnels/src/index.ts"
      ],
      "@slop-lab/dim-control-plane": [
        "core/packages/control-plane/src/index.ts"
      ],
      "@slop-lab/dim-control-plane/plugin": [
        "core/packages/control-plane/src/plugin.ts"
      ],
      "@slop-lab/dim-control-plane/lock": [
        "core/packages/control-plane/src/lock.ts"
      ]
    },
    "typeRoots": [
      "./tests/node_modules/@types"
    ]
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    ".git/**",
    ".local/**"
  ]
}
