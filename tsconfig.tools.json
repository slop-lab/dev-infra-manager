{
  "extends": "./tsconfig.source.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./tests/node_modules/@types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.d.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "tools/**/*.ts",
    "packages/**/scripts/**/*.ts",
    "packages/gs/build-package.ts",
    "examples/**/*.ts",
    "packages/**/image/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    ".git/**",
    ".local/**"
  ]
}
