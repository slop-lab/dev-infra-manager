{
  "name": "@slop-lab/dim-core-repository",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm --filter @slop-lab/dim-core... --filter @slop-lab/dim-managed... --filter @slop-lab/dim-cli... --filter @slop-lab/dim-installer... --filter @slop-lab/dim-native-git... --filter @slop-lab/dim-web... --filter @slop-lab/dim-contracts-external-url... run check",
    "build": "pnpm --filter @slop-lab/dim-core... --filter @slop-lab/dim-managed... --filter @slop-lab/dim-cli... --filter @slop-lab/dim-installer... --filter @slop-lab/dim-native-git... --filter @slop-lab/dim-web... --filter @slop-lab/dim-contracts-external-url... run build",
    "verify": "pnpm run check && pnpm run build"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.13.1"
}
