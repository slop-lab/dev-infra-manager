{
  "name": "@slop-lab/dim-managed",
  "version": "0.10.0",
  "description": "Optional DIM managed Git workspaces, review, CI, controller and host integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "core/packages/managed"
  },
  "homepage": "https://github.com/slop-lab/dev-infra-manager#readme",
  "bugs": "https://github.com/slop-lab/dev-infra-manager/issues",
  "keywords": [
    "containers",
    "development",
    "isolation",
    "workspace"
  ],
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./src/cli/managed-cli.ts",
      "import": "./dist/cli/managed-cli.js"
    },
    "./host": {
      "types": "./src/nativeWorkspaceHost.ts",
      "import": "./dist/nativeWorkspaceHost.js"
    }
  },
  "bin": {
    "dim-service": "./dist/nativeOrdinaryServiceCli.js",
    "dim-native-qemu-service": "./dist/nativeQemuServiceCli.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-publish-package.mjs",
    "pack:dry-run": "pnpm run build && bash ../../scripts/pnpm-pack-dry-run.bash ./dist",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slop-lab/dim-core": "workspace:0.10.0",
    "@slop-lab/dim-controller-proxy": "workspace:0.10.0",
    "yaml": "2.8.3",
    "commander": "14.0.0",
    "@slop-lab/dim-native-git": "workspace:0.10.0",
    "@slop-lab/dim-plugin-ci-workflows": "workspace:0.10.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "typescript": "5.8.3"
  }
}
