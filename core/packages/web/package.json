{
  "name": "@slop-lab/dim-web",
  "version": "0.10.0",
  "description": "Optional authenticated workspace, CI and managed Git operations UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "core/packages/web"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dim-reviewer-web": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-publish-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash ../../scripts/pnpm-pack-dry-run.bash ./dist"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "typescript": "5.8.3",
    "@slop-lab/dim-managed": "workspace:*"
  },
  "peerDependencies": {
    "@slop-lab/dim-managed": "0.10.0"
  },
  "peerDependenciesMeta": {
    "@slop-lab/dim-managed": {
      "optional": true
    }
  }
}
