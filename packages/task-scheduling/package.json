{
  "name": "@slop-lab/dim-task-scheduling",
  "version": "0.10.0",
  "description": "Durable DIM task reservations, leases and typed task contracts",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/task-scheduling"
  },
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "dim-source": {
        "types": "./src/types.ts",
        "default": "./src/types.ts"
      },
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash ../../scripts/packages/pnpm-pack-dry-run.bash ./dist"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
