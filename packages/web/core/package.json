{
  "name": "@slop-lab/dim-web",
  "version": "0.10.0",
  "description": "Authenticated workspace console and Web feature plugin runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/web/core"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-api": {
      "dim-source": {
        "types": "./src/plugin-api.ts",
        "default": "./src/plugin-api.ts"
      },
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.js",
      "default": "./dist/plugin-api.js"
    }
  },
  "bin": {
    "dim-web": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash ../../../scripts/packages/pnpm-pack-dry-run.bash ./dist"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.1.11",
    "@slop-lab/dim-contracts-operations": "workspace:0.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "typescript": "5.8.3"
  }
}
