{
  "name": "@slop-lab/dim-web-plugin-agent-tools",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "DIM Web workspace tool setup and OpenCode server management",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": { "types": "./src/index.ts", "default": "./src/index.ts" },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts"
  },
  "engines": { "node": "^24.0.0 || ^26.0.0" },
  "dependencies": {
    "zod": "4.1.11",
    "@slop-lab/dim-contracts-operations": "workspace:0.10.0"
  },
  "peerDependencies": { "@slop-lab/dim-web": "0.10.0" },
  "devDependencies": {
    "@slop-lab/dim-web": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
