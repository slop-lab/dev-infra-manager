{
  "name": "@slop-lab/dim-web-plugin-native-git",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "DIM Web native-git management plugin",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "zod": "4.6.6",
    "@slop-lab/dim-contracts-operations": "workspace:0.10.0",
    "@slop-lab/dim-service-client-native-git": "workspace:0.10.0",
    "@slop-lab/git-blame": "workspace:0.10.0",
    "@slop-lab/git-diff": "workspace:0.10.0",
    "@slop-lab/git-pull-requests": "workspace:0.10.0",
    "@slop-lab/react-git-diff": "workspace:0.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@slop-lab/react-git-pull-requests": "workspace:0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-web": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-web": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3",
    "esbuild": "0.28.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
