{
  "name": "@slop-lab/dim-control-plane-plugin-git-diff",
  "version": "0.10.0",
  "description": "Authenticated immutable Git diffs for DIM repository services",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/control-plane/plugins/git-diff"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-api": {
      "dim-source": {
        "types": "./src/plugin-api.ts",
        "default": "./src/plugin-api.ts"
      },
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.js",
      "default": "./dist/plugin-api.js"
    }
  },
  "scripts": {
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash ../../../../scripts/packages/pnpm-pack-dry-run.bash ./dist"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slop-lab/gs-diff": "workspace:0.10.0",
    "zod": "4.6.6",
    "@slop-lab/dim-contracts-git": "workspace:0.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3",
    "@slop-lab/dim-control-plane-core": "workspace:0.10.0",
    "@slop-lab/dim-control-plane-plugin-git-repositories": "workspace:0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-control-plane-core": "0.10.0",
    "@slop-lab/dim-control-plane-plugin-git-repositories": "0.10.0"
  }
}
