    "@slop-lab/dim-control-plane-core": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-control-plane-core": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dim-ci-service": "./dist/cli.js"
  }
