{
  "name": "@slop-lab/dim-control-plane-plugin-ci",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Durable CI coordination, worker leases and private execution results",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts"
  },
  "dependencies": {
    "@slop-lab/dim-contracts-ci": "workspace:0.10.0",
    "zod": "4.1.11",
