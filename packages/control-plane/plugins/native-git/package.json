{
  "name": "@slop-lab/dim-plugin-control-plane-native-git",
  "version": "0.10.0",
  "description": "DIM control-plane plugin for Project Git repositories, review and promotion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/control-plane/plugins/native-git"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./src/service.ts",
      "import": "./dist/service.js"
    },
    "./workflow": {
      "types": "./src/workflowCompiler.ts",
      "import": "./dist/workflowCompiler.js"
    },
    "./execution": {
      "types": "./src/execution-protocol.ts",
      "import": "./dist/execution-protocol.js"
    },
    "./config": {
      "types": "./src/bundle-config.ts",
      "import": "./dist/bundle-config.js"
    }
  },
  "bin": {
    "dim-native-git": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../../../scripts/packages/clean-package-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-publish-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash ../../../../scripts/packages/pnpm-pack-dry-run.bash ./dist"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "typescript": "5.8.3",
    "@slop-lab/dim-control-plane": "workspace:0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-control-plane": "0.10.0"
  }
}
