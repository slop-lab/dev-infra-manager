{
  "name": "@slop-lab/dim-control-plane-plugin-code-review",
  "version": "0.10.0",
  "description": "Optional authoritative human code review for DIM Git repositories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/control-plane/plugins/code-review"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extensions": {
      "types": "./src/extensions.ts",
      "import": "./dist/extensions.js",
      "default": "./dist/extensions.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./client": {
      "types": "./src/review-client.ts",
      "import": "./dist/review-client.js",
      "default": "./dist/review-client.js"
    }
  },
  "scripts": {
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash ../../../../scripts/packages/pnpm-pack-dry-run.bash ./dist"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.1.11",
    "@slop-lab/dim-contracts-git": "workspace:0.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3",
    "@slop-lab/dim-control-plane-core": "workspace:0.10.0",
    "@slop-lab/dim-control-plane-plugin-git-repositories": "workspace:0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-control-plane-core": "0.10.0",
    "@slop-lab/dim-control-plane-plugin-git-repositories": "0.10.0"
  },
  "bin": {
    "dim-code-review": "./dist/cli.js"
  }
}
