{
  "name": "@slop-lab/dim-control-plane-plugin-llm-router",
  "version": "0.10.0",
  "private": true,
  "description": "Standalone project LLM routing, private provider credentials and durable usage",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../../scripts/packages/clean-package-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-publish-package.mjs"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slop-lab/dim-control-plane-core": "workspace:0.10.0"
  },
  "bin": {
    "dim-control-plane-llm-router": "./dist/main.js"
  }
}
