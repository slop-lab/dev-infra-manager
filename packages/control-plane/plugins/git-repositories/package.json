{
  "name": "@slop-lab/dim-control-plane-plugin-git-repositories",
  "version": "0.10.0",
  "description": "Git repository registration, import, scoped transport and protected ref transactions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/control-plane/plugins/git-repositories"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./service": {
      "dim-source": {
        "types": "./src/service.ts",
        "default": "./src/service.ts"
      },
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./config": {
      "dim-source": {
        "types": "./src/bundle-config.ts",
        "default": "./src/bundle-config.ts"
      },
      "types": "./dist/bundle-config.d.ts",
      "import": "./dist/bundle-config.js"
    },
    "./plugin-api": {
      "dim-source": {
        "types": "./src/plugin-api.ts",
        "default": "./src/plugin-api.ts"
      },
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.js",
      "default": "./dist/plugin-api.js"
    }
  },
  "scripts": {
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash ../../../../scripts/packages/pnpm-pack-dry-run.bash ./dist"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.1.11",
    "@slop-lab/dim-contracts-git": "workspace:0.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3",
    "@slop-lab/dim-control-plane-core": "workspace:0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-control-plane-core": "0.10.0"
  }
}
