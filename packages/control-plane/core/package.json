{
  "name": "@slop-lab/dim-control-plane-core",
  "version": "0.10.0",
  "description": "Standalone DIM control-plane plugin runtime",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./lock": {
      "types": "./src/lock.ts",
      "import": "./dist/lock.js",
      "default": "./dist/lock.js"
    }
  },
  "bin": {
    "dim-control-plane": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
