{
  "name": "@slop-lab/dim-control-plane-admin",
  "version": "0.10.0",
  "description": "Optional DIM control-plane deployment and operator clients",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "dim-source": {
        "types": "./src/cli/index.ts",
        "default": "./src/cli/index.ts"
      },
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./ci": {
      "dim-source": {
        "types": "./src/ci/operations.ts",
        "default": "./src/ci/operations.ts"
      },
      "types": "./dist/ci/operations.d.ts",
      "import": "./dist/ci/operations.js",
      "default": "./dist/ci/operations.js"
    },
    "./service-pair": {
      "dim-source": {
        "types": "./src/service-pair.ts",
        "default": "./src/service-pair.ts"
      },
      "types": "./dist/service-pair.d.ts",
      "import": "./dist/service-pair.js",
      "default": "./dist/service-pair.js"
    },
    "./execution": {
      "dim-source": {
        "types": "./src/execution/operations.ts",
        "default": "./src/execution/operations.ts"
      },
      "types": "./dist/execution/operations.d.ts",
      "import": "./dist/execution/operations.js",
      "default": "./dist/execution/operations.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/control-plane/admin"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "@slop-lab/dim-host-core": "workspace:0.10.0",
    "@slop-lab/dim-host-plugin-native-git": "workspace:0.10.0",
    "@slop-lab/dim-contracts-ci": "workspace:0.10.0",
    "@slop-lab/dim-control-plane-plugin-git-repositories": "workspace:0.10.0",
    "commander": "14.0.0",
    "zod": "4.1.11",
    "@slop-lab/dim-control-plane-plugin-code-review": "workspace:0.10.0",
    "@slop-lab/dim-control-plane-plugin-merge-policy": "workspace:0.10.0",
    "@slop-lab/dim-control-plane-plugin-git-ci": "workspace:0.10.0",
    "@slop-lab/dim-contracts-git": "workspace:0.10.0",
    "@slop-lab/dim-contracts-execution": "workspace:0.10.0",
    "@slop-lab/dim-control-plane-plugin-execution-scheduler": "workspace:0.10.0",
    "@slop-lab/dim-host-plugin-execution-worker": "workspace:0.10.0",
    "@slop-lab/dim-execution-client": "workspace:0.10.0",
    "@slop-lab/dim-control-plane-plugin-git-sync": "workspace:0.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
