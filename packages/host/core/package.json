{
  "name": "@slop-lab/dim-host-core",
  "version": "0.10.0",
  "description": "Persistent isolated workspaces from local and remote Git repositories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/host/core"
  },
  "homepage": "https://github.com/slop-lab/dev-infra-manager#readme",
  "bugs": "https://github.com/slop-lab/dev-infra-manager/issues",
  "keywords": [
    "containers",
    "development",
    "isolation",
    "workspace"
  ],
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "dim-source": {
        "types": "./src/workspace.ts",
        "default": "./src/workspace.ts"
      },
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./controller": {
      "dim-source": {
        "types": "./src/controller/index.ts",
        "default": "./src/controller/index.ts"
      },
      "types": "./dist/controller/index.d.ts",
      "import": "./dist/controller/index.js",
      "default": "./dist/controller/index.js"
    },
    "./controller/cli": {
      "dim-source": {
        "types": "./src/controller/cli/index.ts",
        "default": "./src/controller/cli/index.ts"
      },
      "types": "./dist/controller/cli/index.d.ts",
      "import": "./dist/controller/cli/index.js",
      "default": "./dist/controller/cli/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "pack:dry-run": "pnpm run build && bash ../../../scripts/packages/pnpm-pack-dry-run.bash ./dist",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "commander": "14.0.0"
  }
}
