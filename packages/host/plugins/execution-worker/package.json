{
  "name": "@slop-lab/dim-host-plugin-execution-worker",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Host execution worker for plugin tasks and isolated container or VM CI slots",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts"
  },
  "dependencies": {
    "@slop-lab/dim-contracts-ci": "workspace:0.10.0",
    "zod": "4.6.6",
    "@slop-lab/dim-contracts-git": "workspace:0.10.0",
    "@slop-lab/dim-contracts-execution": "workspace:0.10.0",
    "@slop-lab/dim-service-client-execution": "workspace:0.10.0",
    "@slop-lab/dim-contracts-operations": "workspace:0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-host-core": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-host-core": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
