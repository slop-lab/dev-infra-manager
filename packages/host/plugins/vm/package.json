{
  "name": "@slop-lab/dim-host-plugin-vm",
  "version": "0.10.0",
  "description": "Persistent Incus VM workspaces and scoped browser consoles for DIM",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js", "default": "./dist/index.js"
    },
    "./budget-setup": "./scripts/install-budget-helper.bash"
  },
  "scripts": {
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-host-core": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-host-core": "workspace:*",
    "@types/node": "24.13.3",
    "typescript": "5.8.3",
    "@types/ws": "8.18.2"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
