{
  "name": "@slop-lab/dim-host-plugin-git-review-tracing-node",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Node review detector task handler for DIM execution worker slots",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts"
  },
  "dependencies": {
    "@slop-lab/dim-contracts-execution": "workspace:0.10.0",
    "@slop-lab/gs-review-tracing": "workspace:0.10.0",
