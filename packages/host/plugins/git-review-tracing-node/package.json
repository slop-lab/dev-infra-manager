    "@slop-lab/dim-host-core": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-host-core": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/host/plugins/git-review-tracing-node"
