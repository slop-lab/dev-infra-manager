{
  "name": "@slop-lab/dim-host-plugin-tailscale",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Optional Tailscale integration for DIM workspace connectivity and ingress",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts"
  },
  "dependencies": {
    "@slop-lab/dim-contracts-external-url": "workspace:0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-host-core": "0.10.0",
    "@slop-lab/dim-host-plugin-external-urls": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-host-core": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3",
    "@slop-lab/dim-host-plugin-external-urls": "workspace:0.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/host/plugins/tailscale"
  },
  "peerDependenciesMeta": {
    "@slop-lab/dim-host-plugin-external-urls": {
      "optional": true
    }
  }
