{
  "name": "@slop-lab/dim-host-plugin-native-git",
  "version": "0.10.0",
  "description": "Native Project acquisition and scoped Git workspaces on a DIM host",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./host": {
      "dim-source": {
        "types": "./src/nativeWorkspaceHost.ts",
        "default": "./src/nativeWorkspaceHost.ts"
      },
      "types": "./dist/nativeWorkspaceHost.d.ts",
      "import": "./dist/nativeWorkspaceHost.js",
      "default": "./dist/nativeWorkspaceHost.js"
    },
    "./cli": {
      "dim-source": {
        "types": "./src/cli/index.ts",
        "default": "./src/cli/index.ts"
      },
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "14.0.0",
    "yaml": "2.8.3",
    "@slop-lab/dim-contracts-git": "workspace:0.10.0",
    "@slop-lab/dim-service-client-native-git": "workspace:0.10.0",
    "@slop-lab/dim-contracts-operations": "workspace:0.10.0",
    "@slop-lab/git-pull-requests": "workspace:0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-host-core": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-host-core": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
