{
  "name": "@slop-lab/dim-plugin-external-urls",
  "version": "0.10.0",
  "description": "Workspace-scoped HTTP, HTTPS, and raw TCP ingresses for DIM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/host/plugins/external-urls"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-publish-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash scripts/pnpm-pack-dry-run.bash"
  },
  "packageManager": "pnpm@10.13.1",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "@slop-lab/dim-contracts-external-url": "0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-core": "0.10.0",
    "@slop-lab/dim-managed": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-core": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "typescript": "5.8.3",
    "@slop-lab/dim-managed": "workspace:0.10.0"
  }
}
