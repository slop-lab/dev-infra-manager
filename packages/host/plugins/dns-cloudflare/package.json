{
  "name": "@slop-lab/dim-host-plugin-dns-cloudflare",
  "version": "0.10.0",
  "description": "Cloudflare DNS provider plugin for DIM external URL ingresses",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/host/plugins/dns-cloudflare"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && bash ../../../../scripts/packages/pnpm-pack-dry-run.bash ./dist"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slop-lab/dim-contracts-external-url": "0.10.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-host-core": "0.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "typescript": "5.8.3",
    "@slop-lab/dim-host-core": "workspace:0.10.0"
  }
}
