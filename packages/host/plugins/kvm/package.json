{
  "name": "@slop-lab/dim-host-plugin-kvm",
  "version": "0.10.0",
  "description": "Explicit KVM device access for isolated verification workspaces",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-host-core": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-host-core": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
