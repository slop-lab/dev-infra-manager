{
  "name": "@slop-lab/dim-host-plugin-llm-router",
  "version": "0.10.0",
  "private": true,
  "description": "Host workspace gateway and remote operator commands for the optional LLM router",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./opencode": {
      "dim-source": {
        "types": "./src/opencode.ts",
        "default": "./src/opencode.ts"
      },
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js",
      "default": "./dist/opencode.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "peerDependencies": {
    "@slop-lab/dim-host-core": "0.10.0"
  },
  "devDependencies": {
    "@slop-lab/dim-host-core": "workspace:0.10.0",
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slop-lab/dim-llm-router-client": "workspace:0.10.0",
    "@slop-lab/dim-contracts-llm-router": "workspace:0.10.0"
  },
  "peerDependenciesMeta": {
    "@slop-lab/dim-host-core": {
      "optional": true
    }
  },
  "bin": {
    "dim-llm-router": "./dist/operator/main.js"
  }
}
