{
  "name": "@slop-lab/gs-react-pull-requests",
  "version": "0.10.0",
  "description": "Controlled React pull request, discussion and diff presentation",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "node ../build-package.ts --asset src/styles.css:styles.css",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "24.13.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "dependencies": {
    "@slop-lab/gs-blame": "workspace:0.10.0",
    "@slop-lab/gs-diff": "workspace:0.10.0",
    "@slop-lab/gs-discussions": "workspace:0.10.0",
    "@slop-lab/gs-react-diff": "workspace:0.10.0",
    "@slop-lab/gs-pull-requests": "workspace:0.10.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
