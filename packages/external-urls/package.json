{
  "name": "@slop-lab/dim-plugin-external-urls",
  "version": "0.2.0",
  "description": "Provider-agnostic named external URL ingresses for DIM",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-publish-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm run build && npm pack --dry-run ./dist",
    "publish:package": "pnpm run build && npm publish ./dist",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "@slop-lab/dev-infra-manager-core": "workspace:0.2.0",
    "@slop-lab/dim-external-url-contracts": "workspace:0.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
