{
  "name": "@slop-lab/dim-contracts-ci",
  "version": "0.10.0",
  "description": "Shared DIM CI protocol schemas and transport",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./execution": {
      "dim-source": {
        "types": "./src/execution-protocol.ts",
        "default": "./src/execution-protocol.ts"
      },
      "types": "./dist/execution-protocol.d.ts",
      "import": "./dist/execution-protocol.js",
      "default": "./dist/execution-protocol.js"
    },
    "./review-status": {
      "dim-source": {
        "types": "./src/review-status.ts",
        "default": "./src/review-status.ts"
      },
      "types": "./dist/review-status.d.ts",
      "import": "./dist/review-status.js",
      "default": "./dist/review-status.js"
    },
    "./aggregate": {
      "dim-source": {
        "types": "./src/aggregate.ts",
        "default": "./src/aggregate.ts"
      },
      "types": "./dist/aggregate.d.ts",
      "import": "./dist/aggregate.js",
      "default": "./dist/aggregate.js"
    },
    "./config": {
      "dim-source": {
        "types": "./src/config.ts",
        "default": "./src/config.ts"
      },
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./worker": {
      "dim-source": {
        "types": "./src/worker.ts",
        "default": "./src/worker.ts"
      },
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./query": {
      "dim-source": {
        "types": "./src/query.ts",
        "default": "./src/query.ts"
      },
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    },
    "./connections": {
      "dim-source": {
        "types": "./src/connections.ts",
        "default": "./src/connections.ts"
      },
      "types": "./dist/connections.d.ts",
      "import": "./dist/connections.js",
      "default": "./dist/connections.js"
    },
    "./workflow-plugin-api": {
      "dim-source": {
        "types": "./src/workflow-plugin-api.ts",
        "default": "./src/workflow-plugin-api.ts"
      },
      "types": "./dist/workflow-plugin-api.d.ts",
      "import": "./dist/workflow-plugin-api.js",
      "default": "./dist/workflow-plugin-api.js"
    },
    "./descriptor": {
      "dim-source": {
        "types": "./src/candidate-execution-schema.ts",
        "default": "./src/candidate-execution-schema.ts"
      },
      "types": "./dist/candidate-execution-schema.d.ts",
      "import": "./dist/candidate-execution-schema.js",
      "default": "./dist/candidate-execution-schema.js"
    },
    "./digest": {
      "dim-source": {
        "types": "./src/candidate-execution.ts",
        "default": "./src/candidate-execution.ts"
      },
      "types": "./dist/candidate-execution.d.ts",
      "import": "./dist/candidate-execution.js",
      "default": "./dist/candidate-execution.js"
    },
    "./events": {
      "dim-source": {
        "types": "./src/events.ts",
        "default": "./src/events.ts"
      },
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/contracts/ci"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "zod": "4.6.6",
    "@slop-lab/dim-contracts-execution": "workspace:0.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
