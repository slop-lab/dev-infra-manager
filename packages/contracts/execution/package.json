{
  "name": "@slop-lab/dim-contracts-execution",
  "version": "0.10.0",
  "description": "Generic execution protocol schemas and worker extension API",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-api": {
      "dim-source": {
        "types": "./src/plugin-api.ts",
        "default": "./src/plugin-api.ts"
      },
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.js",
      "default": "./dist/plugin-api.js"
    },
    "./config": {
      "dim-source": {
        "types": "./src/config.ts",
        "default": "./src/config.ts"
      },
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./connections": {
      "dim-source": {
        "types": "./src/connections.ts",
        "default": "./src/connections.ts"
      },
      "types": "./dist/connections.d.ts",
      "import": "./dist/connections.js",
      "default": "./dist/connections.js"
    },
    "./query": {
      "dim-source": {
        "types": "./src/query.ts",
        "default": "./src/query.ts"
      },
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "packages/contracts/execution"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
