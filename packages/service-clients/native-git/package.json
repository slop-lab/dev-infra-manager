{
  "name": "@slop-lab/dim-service-client-native-git",
  "version": "0.10.0",
  "private": true,
  "description": "Native Git inspection, pull request decisions, DIM CI status and sync without a host or Web runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dim-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../../scripts/packages/clean-package-dist.ts && tsc -p tsconfig.build.json && node scripts/build-publish-package.ts"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slop-lab/dim-contracts-operations": "workspace:0.10.0",
    "zod": "4.6.6",
    "@slop-lab/dim-contracts-git": "workspace:0.10.0",
    "@slop-lab/dim-contracts-ci": "workspace:0.10.0",
    "@slop-lab/git-blame": "workspace:0.10.0",
    "@slop-lab/git-diff": "workspace:0.10.0",
    "@slop-lab/git-discussions": "workspace:0.10.0",
    "@slop-lab/git-pull-requests": "workspace:0.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
