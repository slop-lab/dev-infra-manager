{
  "name": "@slop-lab/dim-plugin-workspace-check",
  "version": "0.10.0",
  "description": "Disposable lifecycle and persistent-data verification for DIM workspaces",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {".": {"types": "./src/index.ts", "import": "./dist/index.js"}},
  "scripts": {
    "build": "node ../core/scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-publish-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {"node": "^24.0.0 || ^26.0.0"},
  "peerDependencies": {"@slop-lab/dim-core": "0.10.0"},
  "devDependencies": {"@slop-lab/dim-core": "workspace:0.10.0", "@types/node": "24.13.3", "typescript": "5.8.3"}
}
