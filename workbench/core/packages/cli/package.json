{
  "name": "@slop-lab/dim-cli",
  "version": "0.8.0",
  "description": "CLI for isolated, persistent AI development workspaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slop-lab/dev-infra-manager.git",
    "directory": "core/packages/cli"
  },
  "homepage": "https://github.com/slop-lab/dev-infra-manager#readme",
  "bugs": "https://github.com/slop-lab/dev-infra-manager/issues",
  "keywords": [
    "ai",
    "cli",
    "containers",
    "development",
    "workspace"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "dim": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-publish-package.mjs",
    "pack:dry-run": "pnpm run build && bash ../../../scripts/pnpm-pack-dry-run.bash ./dist",
    "check": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "test": "pnpm --filter @slop-lab/dim-core run build && tsx --test test/*.test.ts"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slop-lab/dim-core": "workspace:0.8.0",
    "commander": "14.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "package.json-minifier": "0.0.6",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
